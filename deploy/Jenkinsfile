// CD_deploy_manual - regular pipeline, started by hand.
// Deploys an already built image to the chosen environment (main or dev).
pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['main', 'dev'], description: 'Target environment')
        string(name: 'IMAGE_TAG', defaultValue: 'v1.0', description: 'Tag of the Docker image to deploy')
    }

    options {
        timestamps()
    }

    stages {
        stage('Set environment') {
            steps {
                script {
                    if (params.ENVIRONMENT == 'main') {
                        env.APP_PORT   = '3000'
                        env.IMAGE_NAME = 'nodemain'
                    } else {
                        env.APP_PORT   = '3001'
                        env.IMAGE_NAME = 'nodedev'
                    }
                    env.CONTAINER_NAME = "app-${params.ENVIRONMENT}"
                    currentBuild.description = "${params.ENVIRONMENT} <- ${env.IMAGE_NAME}:${params.IMAGE_TAG}"
                }
                echo "Deploying ${env.IMAGE_NAME}:${params.IMAGE_TAG} to ${params.ENVIRONMENT} on port ${env.APP_PORT}"
            }
        }

        stage('Check image') {
            steps {
                sh 'docker image inspect ${IMAGE_NAME}:${IMAGE_TAG} --format "Found {{.Id}}"'
            }
        }

        stage('Deploy') {
            steps {
                // Only the container of the selected environment is replaced.
                sh '''
                    OLD=$(docker ps -aq --filter "name=^${CONTAINER_NAME}$")
                    if [ -n "$OLD" ]; then docker rm -f $OLD; fi
                    docker run -d --name ${CONTAINER_NAME} --expose ${APP_PORT} -p ${APP_PORT}:3000 ${IMAGE_NAME}:${IMAGE_TAG}
                    docker ps --filter "name=^app-"
                '''
                echo "Deployed: http://localhost:${env.APP_PORT}"
            }
        }
    }
}
